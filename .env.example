# Meta Global AI Developer Hackathon 2026 Environment Configuration
# Note: You can run without API keys using the zero-dependency `--replay` flag!

# Baseten API Configuration (Powers Meta Muse Spark Open Epistemic Auditor)
BASETEN_API_KEY=your_baseten_key_here
BASETEN_API_BASE=https://inference.baseten.co/v1

# Fireworks AI Configuration (Powers Meta Llama 3.3 70B & 8B + Vali Co-Pilot)
FIREWORKS_API_KEY=your_fireworks_key_here
FIREWORKS_API_BASE=https://api.fireworks.ai/inference/v1

# Optional Fallback / Alternative Meta Open-Weights Provider
GROQ_API_KEY=your_groq_key_here

# Tavily Real-Time Web Search (Optional for live web queries)
TAVILY_API_KEY=your_tavily_key_here
